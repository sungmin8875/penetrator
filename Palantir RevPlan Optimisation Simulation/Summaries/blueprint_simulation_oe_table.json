          },
          "parameters": {
            "__IMTCONN__": {
              "data": {
                "scoped": "true",
                "connection": "celonis7"
              },
              "label": "OE connection"
            }
          }
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:celonis7",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "instanceId",
            "type": "text",
            "label": "Digital Process Instance ID",
            "required": true
          },
          {
            "name": "executionId",
            "type": "text",
            "label": "Action Flow Execution ID",
            "required": true
          },
          {
            "name": "scenarioId",
            "type": "text",
            "label": "Action Flow ID",
            "required": true
          },
          {
            "name": "type",
            "type": "select",
            "label": "Event Type",
            "required": true
          },
          {
            "name": "timestamp",
            "type": "date",
            "label": "Timestamp"
          },
          {
            "name": "subject",
            "type": "text",
            "label": "Subject"
          },
          {
            "name": "payload",
            "type": "select",
            "label": "Payload",
            "validate": {
              "enum": [
                "text"
              ]
            }
          }
        ]
      }
    }
